{
  "academicYearId": "{{academicYearId}}",
  "termName": "Term 2",
  "startDate": "2026-05-04",
  "endDate": "2026-07-31"
}


### ============================================
### CREATE TERM 3
### ============================================

POST {{baseUrl}}/schools/{{schoolId}}/terms
