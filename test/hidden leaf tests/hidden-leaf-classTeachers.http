### =====================================================

### GET ALL ASSIGNMENTS

### =====================================================

GET {{baseUrl}}/schools/{{schoolId}}/class-teacher-assignments

### =====================================================

### GET ASSIGNMENTS BY TEACHER — IRUKA

### =====================================================

GET {{baseUrl}}/schools/{{schoolId}}/class-teacher-assignments/teacher/{{irukaId}}

### =====================================================

### GET ASSIGNMENTS BY TEACHER — ASUMA

### =====================================================

GET {{baseUrl}}/schools/{{schoolId}}/class-teacher-assignments/teacher/{{asumaId}}

### =====================================================

### GET ASSIGNMENTS BY TEACHER — KAKASHI

### =====================================================

GET {{baseUrl}}/schools/{{schoolId}}/class-teacher-assignments/teacher/{{kakashiId}}

### =====================================================

### GET CLASS TEACHER — GRADE 6 A

### =====================================================

GET {{baseUrl}}/schools/{{schoolId}}/class-teacher-assignments/class/{{grade6AId}}

### =====================================================

### GET CLASS TEACHER — GRADE 6 B

### =====================================================

GET {{baseUrl}}/schools/{{schoolId}}/class-teacher-assignments/class/{{grade6BId}}

### =====================================================

### GET CLASS TEACHER — GRADE 7 B

### =====================================================

GET {{baseUrl}}/schools/{{schoolId}}/class-teacher-assignments/class/{{grade7BId}}

### =====================================================

### GET ASSIGNMENTS FOR 2026

### =====================================================

GET {{baseUrl}}/schools/{{schoolId}}/class-teacher-assignments/academic-year/{{academicYearId}}

### =====================================================

### GET ONE ASSIGNMENT

### =====================================================

GET {{baseUrl}}/schools/{{schoolId}}/class-teacher-assignments/{{assignmentId}}

### =====================================================

### DELETE ASSIGNMENT

### =====================================================

DELETE {{baseUrl}}/schools/{{schoolId}}/class-teacher-assignments/{{assignmentId}}

### =====================================================

### VALIDATION — MISSING TEACHER

### =====================================================

POST {{baseUrl}}/schools/{{schoolId}}/class-teacher-assignments
Content-Type: application/json

{
  "classId": "{{grade6AId}}",
  "academicYearId": "{{academicYearId}}"
}

### =====================================================

### VALIDATION — INVALID TEACHER UUID

### =====================================================

POST {{baseUrl}}/schools/{{schoolId}}/class-teacher-assignments
Content-Type: application/json

{
  "teacherId": "not-a-uuid",
  "classId": "{{grade6AId}}",
  "academicYearId": "{{academicYearId}}"
}
