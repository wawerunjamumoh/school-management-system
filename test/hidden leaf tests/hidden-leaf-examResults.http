###########################################################
# CREATE RESULTS
###########################################################

### Naruto - Mathematics
POST {{baseUrl}}/schools/{{schoolId}}/exam-results
Content-Type: application/json

{
  "studentId": "{{narutoId}}",
  "subjectId": "{{mathSubjectId}}",
  "examId": "{{examId}}",
  "termId": "{{termId}}",
  "score": 72
}


