###########################################################
# READ - CLASS + SUBJECT
###########################################################

### Grade 6 A - Mathematics
GET {{baseUrl}}/schools/{{schoolId}}/exam-results/class/{{class6AId}}/subject/{{mathSubjectId}}


### Grade 6 A - English
GET {{baseUrl}}/schools/{{schoolId}}/exam-results/class/{{class6AId}}/subject/{{englishSubjectId}}


###########################################################
# READ - STUDENT + TERM
###########################################################

### Naruto - Term 1 Results
GET {{baseUrl}}/schools/{{schoolId}}/exam-results/student/{{narutoId}}/term/{{termId}}


### Sakura - Term 1 Results
GET {{baseUrl}}/schools/{{schoolId}}/exam-results/student/{{sakuraId}}/term/{{termId}}


### Sasuke - Term 1 Results
GET {{baseUrl}}/schools/{{schoolId}}/exam-results/student/{{sasukeId}}/term/{{termId}}


###########################################################
# READ - ONE RESULT
###########################################################

### Get One Exam Result
GET {{baseUrl}}/schools/{{schoolId}}/exam-results/{{examResultId}}


###########################################################
# UPDATE
###########################################################

### Update Score
PATCH {{baseUrl}}/schools/{{schoolId}}/exam-results/{{examResultId}}
Content-Type: application/json

{
  "score": 78
}


### Update Subject
PATCH {{baseUrl}}/schools/{{schoolId}}/exam-results/{{examResultId}}
Content-Type: application/json

{
  "subjectId": "{{scienceSubjectId}}"
}


### Update Multiple Fields
PATCH {{baseUrl}}/schools/{{schoolId}}/exam-results/{{examResultId}}
Content-Type: application/json

{
  "subjectId": "{{mathSubjectId}}",
  "score": 85
}


###########################################################
# DELETE
###########################################################

### Delete Exam Result
DELETE {{baseUrl}}/schools/{{schoolId}}/exam-results/{{examResultId}}


###########################################################
# VALIDATION TESTS
###########################################################

### Missing Student ID
POST {{baseUrl}}/schools/{{schoolId}}/exam-results
Content-Type: application/json

{
  "subjectId": "{{mathSubjectId}}",
  "examId": "{{examId}}",
  "termId": "{{termId}}",
  "score": 70
}


### Invalid Student ID
POST {{baseUrl}}/schools/{{schoolId}}/exam-results
Content-Type: application/json

{
  "studentId": "not-a-uuid",
  "subjectId": "{{mathSubjectId}}",
  "examId": "{{examId}}",
  "termId": "{{termId}}",
  "score": 70
}


### Missing Subject ID
POST {{baseUrl}}/schools/{{schoolId}}/exam-results
Content-Type: application/json

{
  "studentId": "{{narutoId}}",
  "examId": "{{examId}}",
  "termId": "{{termId}}",
  "score": 70
}


### Invalid Exam ID
POST {{baseUrl}}/schools/{{schoolId}}/exam-results
Content-Type: application/json

{
  "studentId": "{{narutoId}}",
  "subjectId": "{{mathSubjectId}}",
  "examId": "not-a-uuid",
  "termId": "{{termId}}",
  "score": 70
}


