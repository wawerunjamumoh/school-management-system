@class6AId = 4db0e58e-b36c-4312-ad2b-c69fc8b308aa

### Grade 6 A - Term 1 Opener
GET {{baseUrl}}/schools/{{schoolId}}/exam-results/class/{{class6AId}}/exam/{{examId}}


# Grade 6 B
@class6BId = 10cb48d2-281d-4fbc-9ca1-bbfa7342f2fd

