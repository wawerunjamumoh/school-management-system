###########################################################
# READ - ALL SCHOOL RESULTS
###########################################################

### Get All Results For School
GET {{baseUrl}}/schools/{{schoolId}}/exam-results


###########################################################
# READ - SUBJECT
###########################################################

### Get Mathematics Results
GET {{baseUrl}}/schools/{{schoolId}}/exam-results/subject/{{mathSubjectId}}


### Get English Results
GET {{baseUrl}}/schools/{{schoolId}}/exam-results/subject/{{englishSubjectId}}


###########################################################
# READ - STUDENT + EXAM
###########################################################

### Naruto - Term 1 Opener Results
GET {{baseUrl}}/schools/{{schoolId}}/exam-results/student/{{narutoId}}/exam/{{examId}}


### Sakura - Term 1 Opener Results
GET {{baseUrl}}/schools/{{schoolId}}/exam-results/student/{{sakuraId}}/exam/{{examId}}


### Sasuke - Term 1 Opener Results
GET {{baseUrl}}/schools/{{schoolId}}/exam-results/student/{{sasukeId}}/exam/{{examId}}


###########################################################
# READ - CLASS + EXAM
###########################################################

