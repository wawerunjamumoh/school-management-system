### =========================================

### 1. KUSHINA → NARUTO

### =========================================

POST {{baseUrl}}/guardian-students
Content-Type: application/json

{
  "guardianId": "{{kushinaId}}",
  "studentId": "{{narutoId}}"
}

### =========================================

### 2. FUGAKU → SASUKE

### =========================================

POST {{baseUrl}}/guardian-students
Content-Type: application/json

{
  "guardianId": "{{fugakuId}}",
  "studentId": "{{sasukeId}}"
}

### =========================================

### 3. MEBUKI → SAKURA

### =========================================

POST {{baseUrl}}/guardian-students
Content-Type: application/json

{
  "guardianId": "{{mebukiId}}",
  "studentId": "{{sakuraId}}"
}

### =========================================

### GET ALL RELATIONSHIPS

### =========================================

GET {{baseUrl}}/guardian-students

### =========================================

### KUSHINA → STUDENTS

### =========================================

GET {{baseUrl}}/guardian-students/guardian/{{kushinaId}}/students

### =========================================

### FUGAKU → STUDENTS

### =========================================

GET {{baseUrl}}/guardian-students/guardian/{{fugakuId}}/students

