### =====================================================

### GET ALL TEACHING ASSIGNMENTS

### =====================================================

GET {{baseUrl}}/schools/{{schoolId}}/teaching-assignments

### =====================================================

### GET ASSIGNMENTS FOR IRUKA

### =====================================================

GET {{baseUrl}}/schools/{{schoolId}}/teaching-assignments/teacher/{{irukaId}}

### =====================================================

### GET ASSIGNMENTS FOR ASUMA

### =====================================================

GET {{baseUrl}}/schools/{{schoolId}}/teaching-assignments/teacher/{{asumaId}}

### =====================================================

### GET ASSIGNMENTS FOR KAKASHI

### =====================================================

GET {{baseUrl}}/schools/{{schoolId}}/teaching-assignments/teacher/{{kakashiId}}

### =====================================================

### GET ASSIGNMENTS FOR GRADE 6 A

### =====================================================

GET {{baseUrl}}/schools/{{schoolId}}/teaching-assignments/class/{{grade6AId}}

### =====================================================

### GET ASSIGNMENTS FOR GRADE 7 B

### =====================================================

GET {{baseUrl}}/schools/{{schoolId}}/teaching-assignments/class/{{grade7BId}}

### =====================================================

### GET MATHEMATICS ASSIGNMENTS

### =====================================================

GET {{baseUrl}}/schools/{{schoolId}}/teaching-assignments/subject/{{mathematicsId}}

### =====================================================

### GET 2026 ASSIGNMENTS

### =====================================================

GET {{baseUrl}}/schools/{{schoolId}}/teaching-assignments/academic-year/{{academicYearId}}

### =====================================================

### GET ONE ASSIGNMENT

### =====================================================

GET {{baseUrl}}/schools/{{schoolId}}/teaching-assignments/{{assignmentId}}

### =====================================================

### UPDATE ASSIGNMENT

### =====================================================

PATCH {{baseUrl}}/schools/{{schoolId}}/teaching-assignments/{{assignmentId}}
Content-Type: application/json

{
  "subjectId": "{{scienceId}}"
}

### =====================================================

### DELETE ASSIGNMENT

### =====================================================

DELETE {{baseUrl}}/schools/{{schoolId}}/teaching-assignments/{{assignmentId}}

### =====================================================

### VALIDATION — MISSING TEACHER

### =====================================================

POST {{baseUrl}}/schools/{{schoolId}}/teaching-assignments
Content-Type: application/json

{
  "classId": "{{grade6AId}}",
  "subjectId": "{{mathematicsId}}",
  "academicYearId": "{{academicYearId}}"
}

### =====================================================

### VALIDATION — INVALID UUID

### =====================================================

POST {{baseUrl}}/schools/{{schoolId}}/teaching-assignments
Content-Type: application/json

{
  "teacherId": "not-a-uuid",
  "classId": "{{grade6AId}}",
  "subjectId": "{{mathematicsId}}",
  "academicYearId": "{{academicYearId}}"
}
